# Dependencies
node_modules
npm-debug.log*

# Next.js build output
.next
out

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Git
.git
.gitignore

# One-time import data and dev-only CLI scripts — not needed by the running app.
# (the 22MB pincode CSV in particular should never end up baked into an image layer)
Data
scripts

# Misc
README.md
*.md

# Deploy artefacts — never part of the build context.
# deploy.sh writes the saved image tarball here, so without this the NEXT build ships the PREVIOUS
# image into its own context: 155 MB of pure waste on every rebuild, growing each time.
*.tgz
*.tar
# Never let a private key reach an image layer.
*.pem
